{
  "manifest_version": 3,
  "name": "Lab Result Formatter",
  "version": "1.2",
  "description": "Formats specific lab result inputs",
  "permissions": ["activeTab", "storage"],
  "host_permissions": ["<all_urls>"],
  "icons": {
    "128": "icon.png"},
  "action": {
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": [
        "modules/rules.js",
        "modules/celebration.js",
        "modules/formatter.js",
        "modules/trigger-buttons.js",
        "modules/ui.js",
        "content.js"
      ],
      "all_frames": true,
      "run_at": "document_idle"
    }
  ]
}
