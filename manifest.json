{
  "manifest_version": 3,
  "name": "Lab Result Formatter",
  "version": "1.2",
  "description": "Formats specific lab result inputs",
  "permissions": ["activeTab", "storage"],
  "icons": {
    "128": "icon.png"},
  "action": {
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": ["*://192.168.1.143/*"],
      "js": ["content.js"],
      "all_frames": true,
      "run_at": "document_idle"
    }
  ]
}
